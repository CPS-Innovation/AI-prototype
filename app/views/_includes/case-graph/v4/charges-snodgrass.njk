      </div>
    </div>


  {# ============================================================
     RIGHT PANE
     ============================================================ #}
  <div class="app-materials-pane__right">
    <div class="app-materials-pane__detail">

      {# ── Theft contrary to s.1 Theft Act 1968 ── #}
      {% call paneChargeDetail(
        "charge-theft-snodgrass",
        "Theft contrary to s.1 Theft Act 1968",
        "accepted",
        "On 15 January 2026, Tabitha Quibble and Percival Snodgrass entered Selfridges. CCTV footage shows Quibble selecting items and concealing them, while Snodgrass acted as a lookout. Both defendants fled but were apprehended within 15 minutes. All stolen property was recovered from their possession."
      ) %}
        <dl class="govuk-summary-list govuk-summary-list--no-border">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Defendant</dt>
            <dd class="govuk-summary-list__value">Percival Snodgrass</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Co-defendant</dt>
            <dd class="govuk-summary-list__value">Tabitha Quibble</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Statutory definition</dt>
            <dd class="govuk-summary-list__value">A person is guilty of theft if he dishonestly appropriates property belonging to another with the intention of permanently depriving the other of it <a href="#" onclick="alert('Opens: L&P guidance')">(Theft Act 1968 s.1(1))</a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Points to prove</dt>
            <dd class="govuk-summary-list__value">
              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Appropriates property (assumes control)</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">CCTV footage shows defendant taking items from shelf and concealing them.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:20&#8211;14:27)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>,
                <a class="govuk-link" href="materials#mat-o-20">Recovered items (JP/01)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Property (tangible personal property)</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Store ownership documentation and witness statement from manager confirm property belonged to Selfridges at time of theft.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-o-20">Recovered items (JP/01)</a>,
                <a href="#" onclick="alert('Opens: Store inventory (Exhibit 11)')">Store inventory (Exhibit 11)</a>,
                <a href="#" onclick="alert('Opens: Store records (Exhibit 12')">Store records (Exhibit 12)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Belonging to another</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Defendant concealed items and attempted to leave without payment, indicating dishonest intent.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-o-20">Recovered items (JP/01)</a>,
                <a href="#" onclick="alert('Opens: Store inventory (Exhibit 11)')">Store inventory (Exhibit 11)</a>,
                <a href="#" onclick="alert('Opens: Store records (Exhibit 12')">Store records (Exhibit 12)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Dishonesty</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Defendant concealed items and attempted to leave without payment, but there is evidence suggesting possible confusion or mistake.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:20&#8211;14:27)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-7">Defendant statement: Tabitha Quibble</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Intention to permanently deprive</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Attempt to leave store with concealed items and no payment made suggests intent to permanently deprive, but there is evidence of possible mistake or lack of intent.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:20&#8211;14:27)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>,
                <a class="govuk-link" href="materials#mat-s-7">Defendant statement: Tabitha Quibble</a>,
                <a href="#" onclick="alert('Opens: Defendant statement: Percival Snodgrass - 888104')">Defendant statement: Percival Snodgrass (888104)</a>,
                <a href="#" onclick="alert('Opens: Defendant statement: Tabitha Quibble - 888111')">Defendant statement: Tabitha Quibble (888111)</a>
              </p>
            </dd>
          </div>
        </dl>
      {% endcall %}

      {# ── Common assault contrary to s.39 Criminal Justice Act 1988 ── #}
      {% call paneChargeDetail(
        "charge-common-assault-snodgrass",
        "Common assault contrary to s.39 Criminal Justice Act 1988",
        "accepted",
        "On 15 January 2026, as Percival Snodgrass and Tabitha Quibble attempted to leave Selfridges, security guard Millicent Bumble moved to intercept them. CCTV footage shows Snodgrass push Bumble with both hands, causing her to fall backward. Bumble sustained bruising to her right shoulder and upper arm. Medical assessment confirmed no injury meeting the ABH threshold. The charge was accordingly reduced from ABH to common assault."
      ) %}
        <dl class="govuk-summary-list govuk-summary-list--no-border">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Defendant</dt>
            <dd class="govuk-summary-list__value">Percival Snodgrass</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Lawyers note</dt>
            <dd class="govuk-summary-list__value">Replaced ABH (s.47 OAPA 1861). Medical evidence confirmed injury was bruising below the ABH threshold; no surgical or ongoing treatment required.</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Statutory definition</dt>
            <dd class="govuk-summary-list__value">A person is guilty of common assault if they intentionally or recklessly apply unlawful force to another, or cause that person to apprehend immediate unlawful force, without their consent. <a href="#" onclick="alert('Opens: L&P guidance')">(Criminal Justice Act 1988 s.39)</a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Points to prove</dt>
            <dd class="govuk-summary-list__value">
              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Applied unlawful force to the victim</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">CCTV footage clearly shows Snodgrass push Bumble with both hands at 14:28. Force is unambiguous and captured in full. Bumble's victim statement corroborates the footage.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Intentional or reckless</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">The push was a directed, two-handed act in response to Bumble's interception. There is no credible basis for a claim it was accidental.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a href="#" onclick="alert('Opens: Defendant statement: Percival Snodgrass - 888104')">Defendant statement: Percival Snodgrass (888104)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Victim did not consent to the force</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Bumble was acting in her professional capacity as security guard. Her victim statement explicitly describes being pushed without warning. No consent to physical contact is implied or evidenced.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>
              </p>
            </dd>
          </div>
        </dl>
      {% endcall %}

      {# ── Assault occasioning actual bodily harm contrary to s.47 Offences Against the Person Act 1861 ── #}
      {% call paneChargeDetail(
        "charge-abh-snodgrass",
        "Assault occasioning actual bodily harm contrary to s.47 Offences Against the Person Act 1861",
        "replaced",
        "On 15 January 2026, when confronted by security guard Millicent Bumble, Snodgrass assaulted her, causing injury. CCTV footage and witness statements confirm the sequence of events, and medical records confirm the injuries sustained by Bumble."
      ) %}
        <dl class="govuk-summary-list govuk-summary-list--no-border">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Defendant</dt>
            <dd class="govuk-summary-list__value">Percival Snodgrass</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Statutory definition</dt>
            <dd class="govuk-summary-list__value">A person is guilty of an offence if they commit an assault and thereby cause actual bodily harm to another person <a href="#" onclick="alert('Opens: L&P guidance')">(Offences Against the Person Act 1861 s.47)</a></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Points to prove</dt>
            <dd class="govuk-summary-list__value">
              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Applied force (common assault)</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">CCTV and witness evidence show Snodgrass used force against Bumble as she attempted to stop the theft.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Intentional or reckless</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Defendant concealed items and attempted to leave without payment, but there is evidence suggesting possible confusion or mistake.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a href="#" onclick="alert('Opens: Defendant statement: Percival Snodgrass - 888104')">Defendant statement: Percival Snodgrass (888104)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Actual bodily harm (ABH) occasioned</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">Medical evidence confirms Bumble suffered actual bodily harm as a result of the incident, including bruising and pain.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>,
                <a class="govuk-link" href="materials#mat-e-6">Medical report (EXH/006)</a>,
                <a class="govuk-link" href="materials#mat-e-7">A&amp;E attendance record (EXH/007)</a>
              </p>

              <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
              <strong>Causal link: force caused ABH</strong>
              <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
                <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI analysis</p>
                <p class="govuk-body">The injuries were directly caused by the push and resulting fall, with no evidence of any other cause.</p>
              </div>
              <p class="govuk-body-s"><strong>Evidence:</strong>
                <a class="govuk-link" href="materials#mat-e-1">CCTV footage (14:28&#8211;14:30)</a>,
                <a class="govuk-link" href="materials#mat-s-2">Victim statement: Millicent Bumble (887580)</a>,
                <a class="govuk-link" href="materials#mat-s-3">Witness statement: Pippa Tiddlepot (888201)</a>,
                <a class="govuk-link" href="materials#mat-e-6">Medical report (EXH/006)</a>,
                <a class="govuk-link" href="materials#mat-e-7">A&amp;E attendance record (EXH/007)</a>
              </p>
            </dd>
          </div>
        </dl>
      {% endcall %}

      {# ── Handling stolen goods contrary to s.22 Theft Act 1968 (AI-identified) ── #}
      {% call paneAiChargeDetail(
        "charge-handling-snodgrass",
        "Handling stolen goods contrary to s.22 Theft Act 1968"
      ) %}
        <p class="govuk-!-margin-bottom-2">If the court is not satisfied beyond reasonable doubt that defendants appropriated with dishonest intent to permanently deprive, they may still find the defendants guilty of handling if they dishonestly received goods they knew or believed to be stolen.</p>
      {% endcall %}


    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var containers = document.querySelectorAll('.js-materials-pane');
    containers.forEach(function (container) {
      new App.MaterialsPane({ container: container });
    });
  });
</script>

</section>
