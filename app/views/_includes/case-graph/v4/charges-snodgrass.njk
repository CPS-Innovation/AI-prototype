{% from "_includes/case-graph/v4/charges-pane-macros.njk" import paneListItem, paneChargeDetail, paneAiChargeDetail %}
<section aria-label="Charges relating to Percival Snodgrass">

  <div class="app-materials-pane js-materials-pane">

    {# ============================================================
       LEFT PANE
       ============================================================ #}
    <div class="app-materials-pane__left">
      <div class="app-materials-pane__list" role="listbox" aria-label="Charges relating to Percival Snodgrass">

        <details class="app-materials-pane__section" open>
          <summary class="app-materials-pane__section-heading">
            Accepted by CPS (2)
          </summary>
          <div class="app-materials-pane__item" role="option" aria-selected="false" data-detail="charge-theft-snodgrass">
            <span class="app-materials-pane__item-name">Theft contrary to s.1 Theft Act 1968</span>
            <span></span>
          </div>
          <div class="app-materials-pane__item" role="option" aria-selected="false" data-detail="charge-common-assault-snodgrass">
            <span class="app-materials-pane__item-name">Common assault contrary to s.39 Criminal Justice Act 1988</span>
            <span></span>
          </div>
        </details>

        <details class="app-materials-pane__section">
          <summary class="app-materials-pane__section-heading">
            Proposed (0)
          </summary>
        </details>

        <details class="app-materials-pane__section">
          <summary class="app-materials-pane__section-heading">
            Amended (0)
          </summary>
        </details>

        <details class="app-materials-pane__section" open>
          <summary class="app-materials-pane__section-heading">
            Replaced (1)
          </summary>
          <div class="app-materials-pane__item" role="option" aria-selected="false" data-detail="charge-abh-snodgrass">
            <span class="app-materials-pane__item-name">ABH contrary to s.47 Offences Against the Person Act 1861</span>
            <span></span>
