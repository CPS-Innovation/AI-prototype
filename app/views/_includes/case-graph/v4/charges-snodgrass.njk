        <details class="app-materials-pane__section" open>
          <summary class="app-materials-pane__section-heading" style="background-color: #f6f1f8; color: #732282; border-bottom-color: #c5a0d4;">
            Linked offences (1)
            <strong class="govuk-tag govuk-tag--yellow" style="font-size: 1rem; vertical-align: middle; margin-left: auto;">AI analysis</strong>
          </summary>
          <div class="app-materials-pane__item app-materials-pane__item--ai" role="option" aria-selected="false" data-detail="charge-handling-snodgrass">
