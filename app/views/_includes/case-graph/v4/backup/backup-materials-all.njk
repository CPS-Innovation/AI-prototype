
{# ============================================================
   MACRO: renders a single material item
   params:
     name        - material name string
     classif     - 'essential' | 'optional' | 'optional'
     aiSummary   - AI assessment text
     dateAdded   - date string
     status      - 'used' | 'unused' | 'none' | 'missing'
     cmsUrl      - href for CMS link
   ============================================================ #}

{% macro materialItem(name, classif, aiSummary, dateAdded, status, cmsUrl) %}
  <div class="app-material-item">

    <div class="app-material-item__header">
      <h3 class="govuk-heading-s govuk-!-margin-bottom-0">{{ name }}</h3>
      <div class="app-material-item__tags">
        {% if status == 'used' %}
          <strong class="govuk-tag govuk-tag--green">Used</strong>
        {% elif status == 'unused' %}
          <strong class="govuk-tag govuk-tag--blue">Unused</strong>
        {% elif status == 'missing' %}
          {% if classif == 'essential' %}
            <strong class="govuk-tag govuk-tag--red">Essential</strong>
          {% elif classif == 'optional' %}
            <strong class="govuk-tag govuk-tag--yellow">Optional</strong>
          {% elif classif == 'optional' %}
            <strong class="govuk-tag govuk-tag--grey">Optional</strong>
          {% endif %}
        {% else %}
          <strong class="govuk-tag govuk-tag--grey">None</strong>
        {% endif %}
      </div>
    </div>

    <div style="border-left: 5px solid #732282; padding-left: 15px; margin: 15px 0;">
      <p class="govuk-body-s" style="color: #732282; margin-bottom: 5px; font-weight: bold;">AI assessment</p>
      <p class="govuk-body-s" style="margin-bottom: 0;">{{ aiSummary }}</p>
    </div>

    {% if status != 'missing' %}
    <p class="govuk-body-s govuk-!-margin-bottom-3"><strong>Date added</strong> {{ dateAdded }}</p>
    {% endif %}

    {% if status != 'missing' %}
    <p class="govuk-body-s govuk-!-margin-bottom-0">
      <a href="#" class="govuk-link" onclick="alert(&quot;Opens: {{ name }} (links to CMS)&quot;)">View on CMS (opens in a new tab)</a>
    </p>
    {% endif %}

  </div>
{% endmacro %}


