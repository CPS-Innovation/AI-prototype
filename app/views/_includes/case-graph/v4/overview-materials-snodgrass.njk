            <!-- AI missing materials -->
            {% if data['m-status'] == 'incomplete' %}
            <div class="app-ai-data-point app-ai-data-point--warning govuk-!-margin-bottom-4">
              <p class="govuk-body-s govuk-!-margin-bottom-1"><strong>AI assessment — missing materials</strong></p>
              <p class="govuk-heading-l govuk-!-margin-bottom-0">1 <span class="govuk-body-s">item flagged as missing</span></p>
            </div>
            {% else %}
            <!-- <div class="app-ai-data-point govuk-!-margin-bottom-4">
              <p class="govuk-body-s govuk-!-margin-bottom-1"><strong>AI assessment — missing materials</strong></p>
              <p class="govuk-heading-l govuk-!-margin-bottom-0">0 <span class="govuk-body-s">items flagged as missing</span></p>
            </div> -->
            {% endif %}

            <!-- Total count -->
            <!-- <p class="govuk-caption-m govuk-!-margin-bottom-0">Total materials</p>
