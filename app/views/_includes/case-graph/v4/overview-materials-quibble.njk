
        <div class="govuk-summary-card{% if data['m-status'] == 'incomplete' %} app-card--status-red{% else %} app-card--status-green{% endif %}">
          <div class="govuk-summary-card__title-wrapper">
            <h2 class="govuk-summary-card__title">Materials</h2>
          </div>
          <div class="govuk-summary-card__content">

            {% if data['m-status'] == 'incomplete' %}
            <div class="app-ai-data-point app-ai-data-point--warning govuk-!-margin-bottom-4" style="padding: 12px 15px;">
              <p class="govuk-body-s govuk-!-margin-bottom-1" style="font-weight: bold;">AI analysis — missing materials</p>
              <p class="govuk-body govuk-!-margin-bottom-0">2 items identified as missing, including 1 essential item (CCTV continuity certificate).</p>
            </div>
            {% else %}
            <div style="border-left: 4px solid #00703c; padding: 12px 15px; background-color: #f3fff5; margin-bottom: 20px;">
              <p class="govuk-body-s govuk-!-margin-bottom-0" style="color: #00703c; font-weight: bold;">AI analysis — all expected materials present</p>
            </div>
            {% endif %}

            <p class="govuk-body-s govuk-!-margin-bottom-0"><a href="materials" class="govuk-link">View materials in more detail</a></p>
          </div>
        </div>
