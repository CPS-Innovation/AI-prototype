{% from "_includes/case-graph/unmoderated/materials-all.njk" import materialItem %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-one-half">

    {# ============================================================
       STATEMENTS CARD
       ============================================================ #}
    <div class="govuk-summary-card govuk-!-margin-bottom-6{% if data['m-status'] == 'incomplete' %} app-card--status-red{% else %} app-card--status-green{% endif %}">
      <div class="govuk-summary-card__title-wrapper">
        <h2 class="govuk-summary-card__title">Statements ({% if data['m-status'] == 'incomplete' %}8{% else %}7{% endif %})</h2>
      </div>
      <div class="govuk-summary-card__content">

        {% if data['m-status'] == 'incomplete' %}
        {{ materialItem(
          "Witness statement from unidentified bystander",
          "optional",
          "6 individuals were present at the scene, but only 5 witness statements have been provided. A statement from the sixth witness (an unidentified bystander) has not been obtained and is not currently in the case file. This may strengthen the prosecution case.",
          "Not obtained",
          "missing",
          "#"
        ) }}
        {% endif %}

        {{ materialItem(
          "Witness statement: Millicent Bumble (Security Guard) — MG11/888200",
          "essential",
          "Primary eyewitness account covering the theft and the stop at the store exit. Describes observing both defendants, the decision to intercept, and the subsequent assault by Snodgrass. Consistent with CCTV footage. High evidential value for both charges.",
          "5 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Victim statement: Millicent Bumble (assault account) — MG11/887580",
          "essential",
          "Separate victim statement from Bumble specifically addressing the assault by Percival Snodgrass at the store exit. Describes being pushed with both hands and falling backward. Details the immediate pain and shock. Consistent with CCTV footage at 2:28pm. Essential to the common assault charge.",
          "6 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Witness statement: Pippa Tiddlepot (Store Manager) — MG11/888201",
          "essential",
          "Confirms the value of the stolen goods and that they belonged to the store. Provides context on store procedure and stock identification. Required to establish appropriation of property belonging to another.",
          "5 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Witness statement: Reginald Crumhorn (Off-duty Police Officer) — MG11/888202",
          "essential",
          "Independent eyewitness who observed both defendants acting suspiciously before approaching the exit. Corroborates store CCTV and security guard testimony.",
          "6 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Witness statement: Lavinia Starch (Cashier) — MG11/888203",
          "optional",
          "Observed the defendants pass the self-checkout area without scanning items. Testimony corroborates the concealment narrative. Desirable for completeness.",
          "6 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Witness statement: Horatio Snipe (Defendant's companion) — MG11/888204",
          "optional",
          "Companion to both defendants on the day of the offence. Claims no knowledge of the theft and was not near Snodgrass during the assault. AI notes potential inconsistencies with CCTV positioning. Useful for disclosure purposes.",
          "8 March 2026",
          "unused",
          "#"
        ) }}

        {{ materialItem(
          "Defence statement — Tabitha Quibble",
          "",
          "Defence claims the items were placed in the bag accidentally and there was no dishonest intent. This narrative is difficult to reconcile with the 12-minute CCTV footage showing deliberate concealment at multiple points in the store.",
          "14 March 2026",
          "used",
          "#"
        ) }}

      </div>
    </div>

  </div>
  <div class="govuk-grid-column-one-half">

    {# ============================================================
       EXHIBITS CARD
       ============================================================ #}
    <div class="govuk-summary-card govuk-!-margin-bottom-6{% if data['m-status'] == 'incomplete' %} app-card--status-red{% else %} app-card--status-green{% endif %}">
      <div class="govuk-summary-card__title-wrapper">
        <h2 class="govuk-summary-card__title">Exhibits ({% if data['m-status'] == 'incomplete' %}8{% else %}7{% endif %})</h2>
      </div>
      <div class="govuk-summary-card__content">

        {% if data['m-status'] == 'incomplete' %}
        {{ materialItem(
          "CCTV continuity certificate — Selfridges, Stoke Newington",
          "essential",
          "A signed continuity record confirming the integrity of the CCTV evidence between seizure and disclosure has not been located in the case file. Without this, the defence may successfully challenge the admissibility of EXH/001 under s.78 PACE 1984. The prosecution case relies heavily on the CCTV footage. This must be resolved before the hearing.",
          "Not located",
          "missing",
          "#"
        ) }}
        {% endif %}

        {{ materialItem(
          "CCTV footage — Selfridges, Stoke Newington (12 mins) — EXH/001",
          "essential",
          "Twelve minutes of continuous footage covering 2:20pm to 2:32pm on 15 January 2026. Captures both the theft and the assault. Shows Snodgrass acting as lookout during the concealment, and at 2:28pm pushing Millicent Bumble with both hands as she attempted to intercept the defendants at the exit. Central exhibit for both the theft and the common assault charge.",
          "4 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Exhibit: recovered black dress (AllSaints) — EXH/002",
          "essential",
          "One of three items recovered from Quibble's bag at the point of stop. Value confirmed as £99.49. Store label intact. Directly supports the appropriation limb of the theft charge.",
          "4 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Exhibit: handbag (AllSaints) — EXH/003",
          "essential",
          "Second item recovered. Value £124.99. Packaging intact with store barcode.",
          "4 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Exhibit: Yoga mat (Lululemon) — EXH/004",
          "essential",
          "Third item recovered. Value £23.02. All three recovered items are consistent with the CCTV footage showing concealment. Together they establish the full extent of the alleged theft.",
          "4 March 2026",
          "used",
          "#"
        ) }}

        {{ materialItem(
          "Custody photograph — Tabitha Quibble — EXH/005",
          "",
          "Standard arrest photograph. Provides identity confirmation but is not relied upon given the defendant was known to store staff. Included for completeness.",
          "4 March 2026",
          "none",
          "#"
        ) }}

        {{ materialItem(
          "Medical report — Millicent Bumble (EXH/006)",
          "",
          "Medical assessment of injuries sustained by Bumble following the push by Snodgrass. Records bruising to the right shoulder and upper arm. Clinician confirmed no fracture, no surgical intervention required, and no ongoing treatment recommended. Injury assessed as below the ABH threshold — this report was a primary factor in the decision to downgrade the charge from ABH to common assault. Retained on the unused material schedule.",
          "18 March 2026",
          "unused",
          "#"
        ) }}

        {{ materialItem(
          "A&E attendance record — Millicent Bumble (EXH/007)",
          "",
          "Record of Bumble's attendance at A&E on 16 January 2026, 12:45pm. Confirms assessment date and time consistent with the incident. Triage notes record shoulder and arm bruising. No treatment administered beyond pain relief. Corroborates the medical report findings. Retained on the unused material schedule as injury did not meet ABH threshold.",
          "20 March 2026",
          "unused",
          "#"
        ) }}

      </div>
    </div>

  </div>
</div>

